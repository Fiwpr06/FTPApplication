<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox prefHeight="780.0" prefWidth="1180.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fiwpr06.ftpapplication.client.controller.FtpClientController">
    <!-- Top Active Connection Bar -->
    <HBox styleClass="quickconnect-bar" alignment="CENTER_LEFT" spacing="12.0">
        <Label text="FTP APPLICATION" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A; -fx-font-size: 14px;" />
        <Separator orientation="VERTICAL" />
        <Label text="Máy chủ:" styleClass="field-label" />
        <TextField fx:id="txtHost" prefWidth="120.0" minWidth="90.0" text="127.0.0.1" promptText="Host" styleClass="text-input-field" />
        <Label text="Bí danh:" styleClass="field-label" />
        <TextField fx:id="txtUser" prefWidth="110.0" minWidth="80.0" text="admin" promptText="Bí danh" styleClass="text-input-field" />
        <Label text="Mã:" styleClass="field-label" />
        <PasswordField fx:id="txtPass" prefWidth="95.0" minWidth="75.0" text="FTP888" promptText="Mã" styleClass="text-input-field" />
        <Label text="Cổng:" styleClass="field-label" />
        <TextField fx:id="txtPort" prefWidth="65.0" minWidth="55.0" text="2121" promptText="Port" styleClass="text-input-field" />
        <Button fx:id="btnQuickconnect" onAction="#handleConnect" styleClass="btn-primary" text="Kết nối lại" />
        <Button fx:id="btnDisconnect" onAction="#handleDisconnect" styleClass="btn-danger" text="Ngắt kết nối" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblAutoSyncStatus" text="Auto-Sync" styleClass="status-pill-sync">
            <graphic>
                <SVGPath content="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" fill="#059669" />
            </graphic>
        </Label>
        <Label fx:id="lblConnectionStatus" text="● Đã kết nối" style="-fx-text-fill: #059669; -fx-font-weight: bold; -fx-background-color: #DCFCE7; -fx-padding: 4px 10px; -fx-background-radius: 12px;" />
    </HBox>

    <!-- Console Log Stream (Collapsible / Resizable) -->
    <TitledPane expanded="false" text="Nhật ký truyền nhận lệnh" prefHeight="130.0" style="-fx-font-weight: bold;">
        <TextArea fx:id="txtConsole" editable="false" styleClass="console-area" wrapText="true" />
    </TitledPane>

    <!-- Main Dual-Pane Explorer -->
    <SplitPane dividerPositions="0.5" VBox.vgrow="ALWAYS" style="-fx-background-color: #F8FAFC; -fx-padding: 6px;">
        <!-- Left Pane: Local Site -->
        <VBox spacing="6.0" styleClass="card-panel">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="explorer-header">
                <Label styleClass="explorer-title" text="Thư mục máy tính:" />
                <TextField fx:id="txtLocalPath" editable="false" HBox.hgrow="ALWAYS" styleClass="text-input-field" />
                <Button onAction="#handleLocalUp" styleClass="btn-secondary" text="Lên">
                    <graphic>
                        <SVGPath content="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" fill="#475569" />
                    </graphic>
                </Button>
                <Button onAction="#handleLocalNewFolder" styleClass="btn-secondary" text="Tạo thư mục">
                    <graphic>
                        <SVGPath content="M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z" fill="#475569" />
                    </graphic>
                </Button>
                <Button onAction="#handlePickAndUpload" styleClass="btn-primary" text="Chọn tệp tải lên">
                    <graphic>
                        <SVGPath content="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z" fill="white" />
                    </graphic>
                </Button>
                <Button onAction="#handleUploadSelected" styleClass="btn-action" text="Tải lên tệp đã chọn">
                    <graphic>
                        <SVGPath content="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" fill="#1D4ED8" />
                    </graphic>
                </Button>
            </HBox>
            <TableView fx:id="tblLocalFiles" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colLocalName" minWidth="220.0" prefWidth="300.0" text="Tên tệp / Thư mục" />
                    <TableColumn fx:id="colLocalSize" minWidth="90.0" prefWidth="105.0" text="Kích thước" />
                    <TableColumn fx:id="colLocalType" minWidth="80.0" prefWidth="90.0" text="Loại" />
                    <TableColumn fx:id="colLocalTime" minWidth="150.0" prefWidth="180.0" text="Thời gian sửa đổi" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <!-- Right Pane: Remote Site -->
        <VBox spacing="6.0" styleClass="card-panel">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="explorer-header">
                <Label styleClass="explorer-title" text="Thư mục máy chủ:" />
                <TextField fx:id="txtRemotePath" editable="false" HBox.hgrow="ALWAYS" text="/" styleClass="text-input-field" />
                <Button onAction="#handleRemoteUp" styleClass="btn-secondary" text="Lên">
                    <graphic>
                        <SVGPath content="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" fill="#475569" />
                    </graphic>
                </Button>
                <Button onAction="#handleRemoteNewFolder" styleClass="btn-secondary" text="Tạo thư mục">
                    <graphic>
                        <SVGPath content="M20 6h-8l-2-2H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z" fill="#475569" />
                    </graphic>
                </Button>
                <Button onAction="#handleDownloadSelected" styleClass="btn-action" text="Tải về máy">
                    <graphic>
                        <SVGPath content="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" fill="#1D4ED8" />
                    </graphic>
                </Button>
                <Button onAction="#handleDownloadToFolder" styleClass="btn-secondary" text="Chọn nơi lưu...">
                    <graphic>
                        <SVGPath content="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" fill="#475569" />
                    </graphic>
                </Button>
                <Button onAction="#handleRemoteDelete" styleClass="btn-danger" text="Xóa">
                    <graphic>
                        <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="white" />
                    </graphic>
                </Button>
            </HBox>
            <TableView fx:id="tblRemoteFiles" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colRemoteName" minWidth="220.0" prefWidth="300.0" text="Tên tệp trên Server" />
                    <TableColumn fx:id="colRemoteSize" minWidth="90.0" prefWidth="105.0" text="Kích thước" />
                    <TableColumn fx:id="colRemotePerm" minWidth="90.0" prefWidth="110.0" text="Quyền hạn" />
                    <TableColumn fx:id="colRemoteTime" minWidth="150.0" prefWidth="180.0" text="Thời gian Server" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </SplitPane>

    <!-- Bottom Transfer Queue Tab -->
    <TabPane prefHeight="160.0" tabClosingPolicy="UNAVAILABLE" styleClass="card-panel">
        <Tab text="Hàng đợi truyền tải">
            <TableView fx:id="tblQueue">
                <columns>
                    <TableColumn fx:id="colQFile" minWidth="240.0" prefWidth="350.0" text="Tệp tin truyền tải" />
                    <TableColumn fx:id="colQType" minWidth="85.0" prefWidth="100.0" text="Chiều truyền" />
                    <TableColumn fx:id="colQSize" minWidth="90.0" prefWidth="110.0" text="Dung lượng" />
                    <TableColumn fx:id="colQProgress" minWidth="160.0" prefWidth="220.0" text="Tiến trình" />
                    <TableColumn fx:id="colQSpeed" minWidth="100.0" prefWidth="130.0" text="Tốc độ" />
                    <TableColumn fx:id="colQStatus" minWidth="110.0" prefWidth="140.0" text="Trạng thái" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </Tab>
    </TabPane>
</VBox>
