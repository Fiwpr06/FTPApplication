<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fiwpr06.ftpapplication.client.controller.ConnectController"
            prefWidth="720.0" prefHeight="550.0"
            stylesheets="@../css/client.css">

    <!-- Thanh tiêu đề phía trên -->
    <top>
        <HBox styleClass="header-bar" spacing="12" alignment="CENTER_LEFT">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="⚡ FTP APPLICATION" styleClass="header-title"/>
            <Label text="FILE TRANSFER SYSTEM" styleClass="header-subtitle"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="GIAO THỨC:" styleClass="status-pill-label"/>
            <Label text="RFC 959 FTP" styleClass="status-pill-value"/>
        </HBox>
    </top>

    <!-- Khung nhập thông tin kết nối (Light Card) -->
    <center>
        <VBox alignment="CENTER" spacing="16">
            <VBox styleClass="card-panel" prefWidth="500.0" maxWidth="500.0" spacing="14">
                <padding>
                    <Insets top="24" right="28" bottom="24" left="28"/>
                </padding>

                <!-- Tiêu đề form -->
                <Label text="XÁC THỰC KẾT NỐI MÁY CHỦ FTP" styleClass="panel-title"/>
                <Label text="Nhập địa chỉ máy chủ, mã kết nối (Passcode) và bí danh để truy cập tệp tin." styleClass="panel-desc"/>

                <!-- Địa chỉ IP / Host -->
                <VBox spacing="4">
                    <Label text="Địa chỉ IP Máy chủ (Cục bộ / Mạng LAN):" styleClass="field-label"/>
                    <TextField fx:id="hostField" promptText="127.0.0.1 (hoặc IP mạng LAN)" text="127.0.0.1" styleClass="text-input-field"/>
                </VBox>

                <!-- Cổng Port -->
                <VBox spacing="4">
                    <Label text="Cổng kết nối (Mặc định: 2121):" styleClass="field-label"/>
                    <TextField fx:id="portField" promptText="2121" text="2121" styleClass="text-input-field"/>
                </VBox>

                <!-- Mã kết nối Passcode -->
                <VBox spacing="4">
                    <Label text="Mã kết nối máy chủ (Passcode):" styleClass="field-label"/>
                    <TextField fx:id="codeField" promptText="Nhập mã kết nối do máy chủ cung cấp (mặc định: FTP888)..." text="FTP888" styleClass="text-input-field"/>
                </VBox>

                <!-- Tên hiển thị -->
                <VBox spacing="4">
                    <Label text="Tên hiển thị / Bí danh của bạn:" styleClass="field-label"/>
                    <TextField fx:id="nameField" promptText="Nhập bí danh (ví dụ: Alice, Bình Minh, Quang)..." styleClass="text-input-field"/>
                </VBox>

                <!-- Trạng thái kết nối -->
                <Label fx:id="statusLabel" text="[ SẴN SÀNG ] Vui lòng nhập bí danh và kết nối." styleClass="status-label-normal" wrapText="true"/>

                <!-- Nút kết nối -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <padding>
                        <Insets top="8"/>
                    </padding>
                    <Button fx:id="connectButton" text="KẾT NỐI MÁY CHỦ FTP" onAction="#handleConnect"
                            styleClass="btn-primary" defaultButton="true" prefWidth="220.0"/>
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="footer-bar" alignment="CENTER_LEFT" spacing="10">
            <padding>
                <Insets top="8" right="16" bottom="8" left="16"/>
            </padding>
            <Label text="FTP Application © 2026 - Chuẩn kết nối phân tán không cần đăng ký tài khoản" styleClass="footer-text"/>
        </HBox>
    </bottom>
</BorderPane>
