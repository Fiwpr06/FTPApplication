<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="720.0" prefWidth="1050.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fiwpr06.ftpapplication.server.controller.FtpServerController">
    <!-- Header HUD Bar -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="hud-bar">
        <Label styleClass="hud-title" text="⚡ FTP APPLICATION SERVER" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="IP Cục bộ:" styleClass="hud-label" />
        <Label fx:id="lblServerIp" text="127.0.0.1" styleClass="hud-ip-value" />
        <Separator orientation="VERTICAL" />
        <Label text="Cổng (Port):" styleClass="hud-label" />
        <TextField fx:id="txtPort" prefWidth="75.0" text="2121" />
        <Separator orientation="VERTICAL" />
        <Label text="Mã kết nối (Passcode):" styleClass="hud-label" />
        <TextField fx:id="txtPasscode" prefWidth="100.0" text="FTP888" styleClass="hud-passcode-field" promptText="Passcode" />
        <Separator orientation="VERTICAL" />
        <Button fx:id="btnStart" onAction="#handleStartServer" styleClass="btn-primary" text="▶ Bật Server" />
        <Button fx:id="btnStop" disable="true" onAction="#handleStopServer" styleClass="btn-danger" text="⏹ Dừng Server" />
        <Label fx:id="lblStatus" styleClass="status-badge-stopped" text="STOPPED" />
    </HBox>

    <!-- Main Content Tabs -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <!-- Tab 1: Active Sessions -->
        <Tab text="Máy khách đang kết nối (Active Sessions)">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Danh sách phiên kết nối thời gian thực (Lưu trữ MySQL):" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" />
                    <Label fx:id="lblClientCount" text="0 clients online" style="-fx-text-fill: #059669; -fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#refreshActiveSessions" styleClass="btn-secondary" text="🔄 Làm mới" />
                    <Button onAction="#disconnectSelectedClient" styleClass="btn-danger" text="❌ Ngắt kết nối Client" />
                </HBox>
                <TableView fx:id="tblSessions" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSessionId" minWidth="90.0" prefWidth="120.0" text="Session ID" />
                        <TableColumn fx:id="colClientIp" minWidth="130.0" prefWidth="160.0" text="Địa chỉ IP Client" />
                        <TableColumn fx:id="colClientPort" minWidth="80.0" prefWidth="95.0" text="Cổng Port" />
                        <TableColumn fx:id="colSessionUser" minWidth="140.0" prefWidth="180.0" text="Bí danh / Username" />
                        <TableColumn fx:id="colSessionPath" minWidth="200.0" prefWidth="280.0" text="Thư mục làm việc hiện tại" />
                        <TableColumn fx:id="colSessionTime" minWidth="160.0" prefWidth="200.0" text="Thời gian kết nối" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- Tab 2: Logs -->
        <Tab text="Nhật ký truyền tệp (MySQL transfer_logs)">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Lịch sử tải lên / tải về tệp tin từ CSDL MySQL:" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#refreshLogs" styleClass="btn-secondary" text="🔄 Tải lại nhật ký" />
                </HBox>
                <TableView fx:id="tblLogs" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colLogId" minWidth="60.0" prefWidth="70.0" text="ID" />
                        <TableColumn fx:id="colLogUser" minWidth="120.0" prefWidth="150.0" text="Người dùng" />
                        <TableColumn fx:id="colLogAction" minWidth="90.0" prefWidth="110.0" text="Thao tác" />
                        <TableColumn fx:id="colLogFile" minWidth="240.0" prefWidth="350.0" text="Tên tệp tin" />
                        <TableColumn fx:id="colLogSize" minWidth="100.0" prefWidth="120.0" text="Dung lượng (Bytes)" />
                        <TableColumn fx:id="colLogStatus" minWidth="90.0" prefWidth="110.0" text="Trạng thái" />
                        <TableColumn fx:id="colLogTime" minWidth="150.0" prefWidth="180.0" text="Thời gian thực hiện" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- Tab 3: Console -->
        <Tab text="Console Log máy chủ">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Luồng dữ liệu lệnh &amp; phản hồi thời gian thực (RFC 959 Protocol Stream):" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#clearConsole" styleClass="btn-secondary" text="🧹 Xóa màn hình" />
                </HBox>
                <TextArea fx:id="txtConsole" editable="false" styleClass="console-area" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>
        </Tab>

        <!-- Tab 4: User Management (MySQL) -->
        <Tab text="Quản lý Tài khoản CSDL (MySQL users)">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Danh sách tài khoản trong bảng MySQL 'users':" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#refreshUsers" styleClass="btn-secondary" text="🔄 Tải lại danh sách" />
                    <Button onAction="#handleDeleteUser" styleClass="btn-danger" text="🗑 Xóa người dùng" />
                </HBox>
                <TableView fx:id="tblUsers" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUserId" minWidth="50.0" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colUsername" minWidth="140.0" prefWidth="180.0" text="Tên người dùng" />
                        <TableColumn fx:id="colPassword" minWidth="120.0" prefWidth="150.0" text="Mật khẩu (Plain text)" />
                        <TableColumn fx:id="colHomeDir" minWidth="200.0" prefWidth="260.0" text="Thư mục gốc lưu trữ" />
                        <TableColumn fx:id="colPermRead" minWidth="80.0" prefWidth="90.0" text="Đọc (R)" />
                        <TableColumn fx:id="colPermWrite" minWidth="80.0" prefWidth="90.0" text="Ghi (W)" />
                        <TableColumn fx:id="colUserActive" minWidth="80.0" prefWidth="90.0" text="Kích hoạt" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <!-- Add User Bar -->
                <TitledPane expanded="false" text="➕ Thêm mới người dùng vào MySQL">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>
                        <TextField fx:id="txtNewUser" promptText="Tên người dùng" />
                        <TextField fx:id="txtNewPass" promptText="Mật khẩu" />
                        <TextField fx:id="txtNewHome" promptText="Thư mục lưu trữ" text="server_storage/files" HBox.hgrow="ALWAYS" />
                        <CheckBox fx:id="chkRead" selected="true" text="Đọc" />
                        <CheckBox fx:id="chkWrite" selected="true" text="Ghi" />
                        <Button onAction="#handleAddUser" styleClass="btn-primary" text="Lưu tài khoản" />
                    </HBox>
                </TitledPane>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
