<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="740.0" prefWidth="1160.0" spacing="0.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fiwpr06.ftpapplication.server.controller.FtpServerController">
    <!-- Header HUD Bar -->
    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="hud-bar">
        <Label styleClass="hud-title" text="FTP APPLICATION SERVER" minWidth="USE_PREF_SIZE" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Cổng:" styleClass="hud-label" minWidth="USE_PREF_SIZE" />
        <TextField fx:id="txtPort" prefWidth="75.0" minWidth="65.0" text="2121" />
        <Button fx:id="btnStart" onAction="#handleStartServer" styleClass="btn-primary" text="▶ Bật Server" minWidth="USE_PREF_SIZE" />
        <Button fx:id="btnStop" disable="true" onAction="#handleStopServer" styleClass="btn-danger" text="■ Dừng Server" minWidth="USE_PREF_SIZE" />
        <Label fx:id="lblStatus" styleClass="status-badge-stopped" text="● Đang dừng" minWidth="USE_PREF_SIZE" />
    </HBox>

    <!-- Prominent Connection Info & Utility Toolbar (PeerChat Style) -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="connection-info-bar">
        <!-- IP Box with Copy -->
        <Label text="IP Máy chủ:" styleClass="hud-label" minWidth="USE_PREF_SIZE" />
        <Label fx:id="lblServerIp" text="127.0.0.1" styleClass="code-badge" minWidth="USE_PREF_SIZE" />
        <Button onAction="#handleCopyIp" styleClass="btn-utility" text="Sao chép IP" minWidth="USE_PREF_SIZE" />

        <Separator orientation="VERTICAL" />

        <!-- Passcode Box with Copy -->
        <Label text="Mã kết nối:" styleClass="hud-label" minWidth="USE_PREF_SIZE" />
        <TextField fx:id="txtPasscode" prefWidth="100.0" minWidth="90.0" text="FTP888" styleClass="passcode-field" promptText="Passcode" />
        <Button onAction="#handleCopyPasscode" styleClass="btn-utility" text="Sao chép mã" minWidth="USE_PREF_SIZE" />

        <!-- Temporary Feedback Toast -->
        <Label fx:id="lblCopyFeedback" text="" styleClass="feedback-toast" minWidth="USE_PREF_SIZE" />

        <Region HBox.hgrow="ALWAYS" />

        <!-- Utility Buttons -->
        <Button onAction="#handleOpenStorageFolder" styleClass="btn-secondary" text="Mở thư mục gốc" minWidth="USE_PREF_SIZE" />
        <Button onAction="#clearConsole" styleClass="btn-secondary" text="Xóa nhật ký" minWidth="USE_PREF_SIZE" />
    </HBox>

    <!-- Main Content Tabs -->
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <!-- Tab 1: Active Sessions -->
        <Tab text="Máy khách đang kết nối">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Danh sách phiên kết nối thời gian thực:" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" minWidth="USE_PREF_SIZE" />
                    <Label fx:id="lblClientCount" text="0 máy khách trực tuyến" style="-fx-text-fill: #059669; -fx-font-weight: bold;" minWidth="USE_PREF_SIZE" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#refreshActiveSessions" styleClass="btn-secondary" text="Làm mới" minWidth="USE_PREF_SIZE" />
                    <Button onAction="#disconnectSelectedClient" styleClass="btn-danger" text="Ngắt kết nối" minWidth="USE_PREF_SIZE" />
                </HBox>
                <TableView fx:id="tblSessions" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSessionId" minWidth="100.0" prefWidth="130.0" text="Mã phiên" />
                        <TableColumn fx:id="colClientIp" minWidth="130.0" prefWidth="160.0" text="Địa chỉ IP" />
                        <TableColumn fx:id="colClientPort" minWidth="80.0" prefWidth="95.0" text="Cổng" />
                        <TableColumn fx:id="colSessionUser" minWidth="140.0" prefWidth="180.0" text="Tên hiển thị" />
                        <TableColumn fx:id="colSessionPath" minWidth="200.0" prefWidth="280.0" text="Thư mục làm việc" />
                        <TableColumn fx:id="colSessionTime" minWidth="160.0" prefWidth="200.0" text="Thời gian kết nối" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- Tab 2: Logs -->
        <Tab text="Nhật ký truyền tệp">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Lịch sử truyền tải tệp tin:" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" minWidth="USE_PREF_SIZE" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#refreshLogs" styleClass="btn-secondary" text="Làm mới" minWidth="USE_PREF_SIZE" />
                </HBox>
                <TableView fx:id="tblLogs" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colLogId" minWidth="60.0" prefWidth="70.0" text="ID" />
                        <TableColumn fx:id="colLogUser" minWidth="120.0" prefWidth="150.0" text="Người dùng" />
                        <TableColumn fx:id="colLogAction" minWidth="90.0" prefWidth="110.0" text="Thao tác" />
                        <TableColumn fx:id="colLogFile" minWidth="240.0" prefWidth="350.0" text="Tên tệp tin" />
                        <TableColumn fx:id="colLogSize" minWidth="100.0" prefWidth="120.0" text="Dung lượng" />
                        <TableColumn fx:id="colLogStatus" minWidth="90.0" prefWidth="110.0" text="Trạng thái" />
                        <TableColumn fx:id="colLogTime" minWidth="150.0" prefWidth="180.0" text="Thời gian" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </Tab>

        <!-- Tab 3: Console -->
        <Tab text="Nhật ký lệnh máy chủ">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Luồng dữ liệu trao đổi lệnh và phản hồi:" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" minWidth="USE_PREF_SIZE" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#clearConsole" styleClass="btn-secondary" text="Xóa nhật ký" minWidth="USE_PREF_SIZE" />
                </HBox>
                <TextArea fx:id="txtConsole" editable="false" styleClass="console-area" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>
        </Tab>

        <!-- Tab 4: User Management -->
        <Tab text="Quản lý tài khoản">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="14.0" left="16.0" right="16.0" top="14.0" />
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Danh sách tài khoản hệ thống:" style="-fx-font-weight: bold; -fx-text-fill: #1E3A8A;" minWidth="USE_PREF_SIZE" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#refreshUsers" styleClass="btn-secondary" text="Làm mới" minWidth="USE_PREF_SIZE" />
                    <Button onAction="#handleDeleteUser" styleClass="btn-danger" text="Xóa người dùng" minWidth="USE_PREF_SIZE" />
                </HBox>
                <TableView fx:id="tblUsers" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUserId" minWidth="50.0" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colUsername" minWidth="140.0" prefWidth="180.0" text="Tên người dùng" />
                        <TableColumn fx:id="colPassword" minWidth="120.0" prefWidth="150.0" text="Mật khẩu" />
                        <TableColumn fx:id="colHomeDir" minWidth="200.0" prefWidth="260.0" text="Thư mục lưu trữ" />
                        <TableColumn fx:id="colPermRead" minWidth="80.0" prefWidth="90.0" text="Quyền đọc" />
                        <TableColumn fx:id="colPermWrite" minWidth="80.0" prefWidth="90.0" text="Quyền ghi" />
                        <TableColumn fx:id="colUserActive" minWidth="80.0" prefWidth="90.0" text="Kích hoạt" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <!-- Add User Bar -->
                <TitledPane expanded="false" text="Thêm người dùng mới">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <padding><Insets bottom="8.0" left="8.0" right="8.0" top="8.0" /></padding>
                        <TextField fx:id="txtNewUser" promptText="Tên người dùng" prefWidth="140.0" />
                        <TextField fx:id="txtNewPass" promptText="Mật khẩu" prefWidth="140.0" />
                        <TextField fx:id="txtNewHome" promptText="Thư mục lưu trữ" text="server_storage/files" HBox.hgrow="ALWAYS" />
                        <CheckBox fx:id="chkRead" selected="true" text="Đọc" minWidth="USE_PREF_SIZE" />
                        <CheckBox fx:id="chkWrite" selected="true" text="Ghi" minWidth="USE_PREF_SIZE" />
                        <Button onAction="#handleAddUser" styleClass="btn-primary" text="Lưu tài khoản" minWidth="USE_PREF_SIZE" />
                    </HBox>
                </TitledPane>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
